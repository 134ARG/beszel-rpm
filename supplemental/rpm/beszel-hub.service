[Unit]
Description=Beszel Hub Service
Documentation=https://beszel.dev
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=beszel
Group=beszel
EnvironmentFile=-/etc/sysconfig/beszel-hub
ExecStart=/usr/bin/beszel serve --http ${BESZEL_HUB_HTTP}
WorkingDirectory=/var/lib/beszel-hub
Restart=on-failure
RestartSec=5
StateDirectory=beszel-hub
RuntimeDirectory=beszel-hub
UMask=0077

# Conservative hardening for the hub data service.
NoNewPrivileges=yes
KeyringMode=private
LockPersonality=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/beszel-hub
RemoveIPC=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
